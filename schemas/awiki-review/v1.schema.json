{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a-wiki.local/schemas/awiki-review/v1.schema.json",
  "title": "awiki-review/v1",
  "description": "Canonical independent-review contract (Agent Review Bus). Codifies the verdict/finding lifecycle practiced through the vNext phase gates. No secrets, private data, hidden reasoning, or full private prompts.",
  "type": "object",
  "required": ["schema", "phase", "cycle", "executor", "status", "head_sha"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "awiki-review/v1" },
    "phase": { "type": "string", "minLength": 1 },
    "cycle": { "type": "integer", "minimum": 1, "description": "Each cycle is attributable to exactly one HEAD SHA" },
    "executor": { "type": "string" },
    "reviewer": { "type": "string" },
    "status": { "enum": ["PLANNED", "IMPLEMENTING", "TESTING", "REVIEW_REQUESTED", "REVIEWING",
                         "CHANGES_REQUIRED", "APPROVED", "CI_VERIFY", "FAILED", "READY"] },
    "verdict": { "enum": ["PASS", "PASS_WITH_NOTES", "CHANGES_REQUIRED", "BLOCK"] },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "area", "summary", "state"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^R-[A-Za-z0-9-]+-\\d{3}$", "description": "Stable finding id, e.g. R-P1-001" },
          "severity": { "enum": ["blocker", "major", "minor", "note"] },
          "area": { "type": "string" },
          "file": { "type": ["string", "null"] },
          "summary": { "type": "string" },
          "required_action": { "type": ["string", "null"] },
          "state": { "enum": ["open", "addressed", "verified", "wont_fix", "superseded"] }
        }
      }
    },
    "required_tests": { "type": "array", "items": { "type": "string" }, "description": "Commands that must pass before READY" },
    "next_action": { "enum": ["FIX_AND_REREVIEW", "RUN_CI_GATE", "MARK_READY", "ESCALATE_HUMAN", "NONE"] },
    "transport": { "enum": ["github", "local-mcp", "remote-queue"], "description": "Durable transport; adapters normalize into this contract" }
  },

  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["REVIEWING", "CHANGES_REQUIRED", "APPROVED", "READY"] } } },
      "then": { "required": ["reviewer", "verdict"],
                "description": "reviewed/approved states need a named reviewer and an explicit verdict" }
    },
    {
      "if": { "properties": { "status": { "enum": ["APPROVED", "READY"] } } },
      "then": {
        "properties": { "verdict": { "enum": ["PASS", "PASS_WITH_NOTES"] } },
        "required": ["findings", "required_tests", "next_action"],
        "description": "approval states accept only passing verdicts and must carry evidence"
      }
    },
    {
      "if": { "properties": { "status": { "enum": ["APPROVED", "READY"] } } },
      "then": {
        "properties": {
          "findings": {
            "not": {
              "contains": {
                "type": "object",
                "properties": { "severity": { "const": "blocker" }, "state": { "const": "open" } },
                "required": ["severity", "state"]
              }
            }
          }
        },
        "description": "unresolved blockers prevent READY/APPROVED (kernel invariant §8)"
      }
    }
  ]
}
